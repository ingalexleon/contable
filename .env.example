# =============================================================================
# Contable - Variables de Entorno
# =============================================================================
# Copiar este archivo a .env y modificar los valores segun su entorno.
# cp .env.example .env

# -----------------------------------------------------------------------------
# Base de Datos (PostgreSQL)
# -----------------------------------------------------------------------------
POSTGRES_USER=contable
POSTGRES_PASSWORD=contable_secret
POSTGRES_DB=contable

# URL de conexion (usada por el backend)
# Para desarrollo local con SQLite: sqlite+aiosqlite:///./contable.db
# Para Docker/produccion con PostgreSQL:
DATABASE_URL=postgresql+asyncpg://user:password@host:port/dbname

# -----------------------------------------------------------------------------
# Aplicacion
# -----------------------------------------------------------------------------
DEBUG=false
SECRET_KEY=cambie-esta-clave-en-produccion

# -----------------------------------------------------------------------------
# JWT (JSON Web Token)
# -----------------------------------------------------------------------------
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# -----------------------------------------------------------------------------
# CORS (Origenes permitidos)
# -----------------------------------------------------------------------------
CORS_ORIGINS=["http://localhost", "http://localhost:80"]

# -----------------------------------------------------------------------------
# SMTP (Correo electronico para recuperacion de contrasena)
# -----------------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu_email@gmail.com
SMTP_PASSWORD=tu_contrasena_de_aplicacion
SMTP_FROM_EMAIL=noreply@contable.local
SMTP_USE_TLS=true

# -----------------------------------------------------------------------------
# Archivos (Subida de comprobantes de pago)
# -----------------------------------------------------------------------------
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE=10485760

# -----------------------------------------------------------------------------
# Usuario Administrador Predeterminado
# Se crea automaticamente al iniciar la aplicacion por primera vez
# -----------------------------------------------------------------------------
DEFAULT_ADMIN_EMAIL=admin@contable.com
DEFAULT_ADMIN_PASSWORD=admin123
DEFAULT_ADMIN_NAME=Administrador
